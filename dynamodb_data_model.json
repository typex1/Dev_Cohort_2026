  "access_patterns": [
    {
      "pattern": "1",
      "description": "Register a produced component",
      "table": "ScaniaComponents",
      "dynamodb_operation": "PutItem",
      "implementation": "aws dynamodb put-item --table-name ScaniaComponents --item '{\"serial_number\": {\"S\": \"GBX-TUC-000105\"}, \"component_type\": {\"S\": \"GEARBOX\"}, \"plant_code\": {\"S\": \"TUC\"}, \"batch_id\": {\"S\": \"GBX-2026-W38-A\"}, \"produced_at\": {\"S\": \"2026-09-14T06:24:00Z\"}, \"status\": {\"S\": \"PRODUCED\"}, \"version\": {\"N\": \"1\"}}' --condition-expression 'attribute_not_exists(#sn)' --expression-attribute-names '{\"#sn\": \"serial_number\"}'"
    },
    {
      "pattern": "2",
      "description": "Get component by serial number",
      "table": "ScaniaComponents",
      "dynamodb_operation": "GetItem",
      "implementation": "aws dynamodb get-item --table-name ScaniaComponents --key '{\"serial_number\": {\"S\": \"GBX-TUC-000101\"}}'"
    },
    {
      "pattern": "3",
      "description": "Install component into vehicle",
      "table": "ScaniaComponents",
      "dynamodb_operation": "UpdateItem",
      "implementation": "aws dynamodb update-item --table-name ScaniaComponents --key '{\"serial_number\": {\"S\": \"GBX-TUC-000102\"}}' --update-expression 'SET #vin = :vin, #installed_at = :ts, #status = :installed, #version = #version + :one' --condition-expression '#status = :produced' --expression-attribute-names '{\"#vin\": \"vin\", \"#installed_at\": \"installed_at\", \"#status\": \"status\", \"#version\": \"version\"}' --expression-attribute-values '{\":vin\": {\"S\": \"9BSR4X20005399403\"}, \":ts\": {\"S\": \"2026-09-30T11:00:00Z\"}, \":installed\": {\"S\": \"INSTALLED\"}, \":produced\": {\"S\": \"PRODUCED\"}, \":one\": {\"N\": \"1\"}}' --return-values ALL_NEW"
    },
    {
      "pattern": "4",
      "description": "List components installed in a vehicle",
      "table": "ScaniaComponents",
      "index": "ByVehicle",
      "dynamodb_operation": "Query",
      "implementation": "aws dynamodb query --table-name ScaniaComponents --index-name ByVehicle --key-condition-expression '#vin = :vin' --expression-attribute-names '{\"#vin\": \"vin\"}' --expression-attribute-values '{\":vin\": {\"S\": \"YS2R4X20005399401\"}}'"
    },
    {
      "pattern": "5",
      "description": "Recall: all components of a batch",
      "table": "ScaniaComponents",
      "index": "ByBatch",
      "dynamodb_operation": "Query",
      "implementation": "aws dynamodb query --table-name ScaniaComponents --index-name ByBatch --key-condition-expression '#batch_id = :batch' --expression-attribute-names '{\"#batch_id\": \"batch_id\"}' --expression-attribute-values '{\":batch\": {\"S\": \"GBX-2026-W38-A\"}}'"
    },
    {
      "pattern": "6",
      "description": "Quarantine a component",
      "table": "ScaniaComponents",
      "dynamodb_operation": "UpdateItem",
      "implementation": "aws dynamodb update-item --table-name ScaniaComponents --key '{\"serial_number\": {\"S\": \"GBX-TUC-000103\"}}' --update-expression 'SET #status = :quarantined, #version = #version + :one' --condition-expression '#version = :expected' --expression-attribute-names '{\"#status\": \"status\", \"#version\": \"version\"}' --expression-attribute-values '{\":quarantined\": {\"S\": \"QUARANTINED\"}, \":expected\": {\"N\": \"2\"}, \":one\": {\"N\": \"1\"}}' --return-values ALL_NEW"
    },
    {
      "pattern": "7",
      "description": "Create vehicle profile",
      "table": "ScaniaVehicles",
      "dynamodb_operation": "PutItem",
      "implementation": "aws dynamodb put-item --table-name ScaniaVehicles --item '{\"vin\": {\"S\": \"9BSR4X20005399403\"}, \"sk\": {\"S\": \"PROFILE\"}, \"model\": {\"S\": \"P 280\"}, \"assembly_plant\": {\"S\": \"SBC\"}, \"build_date\": {\"S\": \"2026-09-30\"}}' --condition-expression 'attribute_not_exists(#vin)' --expression-attribute-names '{\"#vin\": \"vin\"}'"
    },
    {
      "pattern": "8",
      "description": "Get vehicle profile",
      "table": "ScaniaVehicles",
      "dynamodb_operation": "GetItem",
      "implementation": "aws dynamodb get-item --table-name ScaniaVehicles --key '{\"vin\": {\"S\": \"YS2R4X20005399401\"}, \"sk\": {\"S\": \"PROFILE\"}}'"
    },
    {
      "pattern": "9",
      "description": "Record service event",
      "table": "ScaniaVehicles",
      "dynamodb_operation": "PutItem",
      "implementation": "aws dynamodb put-item --table-name ScaniaVehicles --item '{\"vin\": {\"S\": \"YS2R4X20005399401\"}, \"sk\": {\"S\": \"SERVICE#2026-12-20T14:00:00Z#EVT-0004\"}, \"event_id\": {\"S\": \"EVT-0004\"}, \"service_date\": {\"S\": \"2026-12-20T14:00:00Z\"}, \"mileage_km\": {\"N\": \"31900\"}, \"workshop\": {\"S\": \"Scania Malmö\"}, \"description\": {\"S\": \"Brake pad replacement\"}}'"
    },
    {
      "pattern": "10",
      "description": "Service history newest first",
      "table": "ScaniaVehicles",
      "dynamodb_operation": "Query",
      "implementation": "aws dynamodb query --table-name ScaniaVehicles --key-condition-expression '#vin = :vin AND begins_with(#sk, :prefix)' --expression-attribute-names '{\"#vin\": \"vin\", \"#sk\": \"sk\"}' --expression-attribute-values '{\":vin\": {\"S\": \"YS2R4X20005399401\"}, \":prefix\": {\"S\": \"SERVICE#\"}}' --no-scan-index-forward --limit 20"
    },
    {
      "pattern": "11",
      "description": "Latest service event",
      "table": "ScaniaVehicles",
      "dynamodb_operation": "Query",
      "implementation": "aws dynamodb query --table-name ScaniaVehicles --key-condition-expression '#vin = :vin AND begins_with(#sk, :prefix)' --expression-attribute-names '{\"#vin\": \"vin\", \"#sk\": \"sk\"}' --expression-attribute-values '{\":vin\": {\"S\": \"YS2R4X20005399401\"}, \":prefix\": {\"S\": \"SERVICE#\"}}' --no-scan-index-forward --limit 1"
    },
    {
      "pattern": "12",
      "description": "Bulk-register a shift's components",
      "table": "ScaniaComponents",
      "dynamodb_operation": "BatchWriteItem",
      "implementation": "aws dynamodb batch-write-item --request-items '{\"ScaniaComponents\": [{\"PutRequest\": {\"Item\": {\"serial_number\": {\"S\": \"FRM-LUL-000302\"}, \"component_type\": {\"S\": \"FRAME\"}, \"plant_code\": {\"S\": \"LUL\"}, \"batch_id\": {\"S\": \"FRM-2026-W40-E\"}, \"produced_at\": {\"S\": \"2026-10-01T05:00:00Z\"}, \"status\": {\"S\": \"PRODUCED\"}, \"version\": {\"N\": \"1\"}}}}, {\"PutRequest\": {\"Item\": {\"serial_number\": {\"S\": \"FRM-LUL-000303\"}, \"component_type\": {\"S\": \"FRAME\"}, \"plant_code\": {\"S\": \"LUL\"}, \"batch_id\": {\"S\": \"FRM-2026-W40-E\"}, \"produced_at\": {\"S\": \"2026-10-01T05:04:00Z\"}, \"status\": {\"S\": \"PRODUCED\"}, \"version\": {\"N\": \"1\"}}}}]}'"
    }
  ]
